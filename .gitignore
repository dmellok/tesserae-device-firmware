# PlatformIO build artifacts
.pio/

# VSCode metadata that platformio regenerates per machine
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# ESP-IDF generated sdkconfig. We commit sdkconfig.defaults and any per-board
# sdkconfig.<board>.defaults overrides (e.g. sdkconfig.ee02.defaults); the
# generated per-env sdkconfig.<env> files stay ignored.
sdkconfig
sdkconfig.*
!sdkconfig.defaults
!sdkconfig.*.defaults

# ESP-IDF component manager
managed_components/
dependencies.lock

# Editor/IDE
.idea/
*.swp
.DS_Store

# Local secrets file (template lives at include/secrets.example.h).
# `secrets.h.*` covers backups left behind by the move-aside pattern
# (secrets.h.bak, secrets.h.release-backup.*).
secrets.h
secrets.h.*
!secrets.example.h

# Release artifacts, from back when releases were built and staged locally.
# Nothing writes here now (CI builds and publishes, see .github/workflows/
# release.yml), but old working copies still have the directory.
/release/

# Python bytecode from the tools/ scripts
__pycache__/
*.pyc

# macOS Finder duplicate artifacts ("name 2.ext", "name 3.ext", ...) --
# never track these
* [0-9].*
* [0-9]
