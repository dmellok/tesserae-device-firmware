# ESP32-S3-Zero: 4 MB flash, 2 MB embedded Quad PSRAM.
# Kept independent of sdkconfig.defaults, which enables octal PSRAM for S3 R8 boards.

# --- Flash / partitions ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4m_ota.csv"

# --- Embedded Quad PSRAM (ESP32-S3FH4R2) ---
# Tesserae keeps the 163200-byte panel frame and network buffers here.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# --- CPU / runtime ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
# app_main performs provisioning or a REST/TLS render cycle on this stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PM_ENABLE=n

# --- Networking / TLS / captive portal ---
CONFIG_LWIP_LOCAL_HOSTNAME="tesserae-esp32"
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
# Accept IPv6-only Tesserae endpoints when the network advertises one.
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# --- Console: native USB serial/JTAG on ESP32-S3 ---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- Diagnostics / filesystem ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y
CONFIG_FATFS_LFN_HEAP=y
